# Copia in ~/.viapal-bot/config.toml e riempi.
# Sta FUORI dal repo: contiene token e numero di telefono.
# Viene riletto a ogni giro del loop: per togliere dal giro una stanza appena
# affittata basta mettere libera = false e salvare. Niente riavvii.

[facebook]
group_id = "2262271623946575"          # AFFITTI Monza e Brianza - CERCO/OFFRO
poll_interval_minutes = 25
active_hours = [8, 23]
scroll_stop_after_seen = 10
max_scroll = 45          # quanto in giù andare nel feed: ~45 basta per 2-3 giorni di post
headed = false                          # true se Facebook comincia a chiedere verifiche
profilo_browser = "~/.viapal-bot/fb-profile"
# UA della sessione con cui è stato fatto il login, per non presentarsi come un
# dispositivo diverso passando in headless. Verificala con:
#   agent-browser --profile ~/.viapal-bot/fb-profile eval 'navigator.userAgent'
user_agent = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"

# Classificare un post è meccanico: un modello piccolo basta e costa un quinto.
# Scrivere il messaggio no, lì serve orecchio. Le classificazioni sono decine
# di volte più numerose delle scritture, quindi è lì che sta quasi tutto il conto.
[llm]
classifier = "claude-haiku-4-5"
composer = "claude-opus-5"

[[stanze]]
id = "camera-3"
libera = true
tipo = "singola"
prezzo = 470
spese_condominio = 80
disponibile_da = "4 settembre"

[[stanze]]
id = "camera-4"
libera = true
tipo = "singola"
prezzo = 500
spese_condominio = 80
disponibile_da = "13 settembre"

[[stanze]]
id = "camera-5"
libera = true
tipo = "singola"
prezzo = 490
spese_condominio = 80
disponibile_da = "4 settembre"

[contatto]
link_galleria = "https://viapal.e-den.it/g/viapal"
link_post_fb = "https://www.facebook.com/groups/2262271623946575/posts/3481154118724980/"
cellulare = "335 838 9194"
# Cosa NON è compreso nel totale canone+condominio. Serve a impedire che il
# composer scriva "tutto incluso": sarebbe un preventivo falso.
nota_utenze = "il riscaldamento è già compreso nelle spese condominiali; le altre utenze (luce, gas, acqua, rifiuti) sono a parte e si dividono fra gli inquilini in base ai consumi."
firma = "Sandro"

# Materiale VERO da cui il composer pesca per incuriosire. Se una cosa non è
# scritta qui, il bot non la può dire: è l'unico argine all'invenzione.
# Ricavato dal post dell'annuncio su Facebook e dai testi della galleria.
[casa]
indirizzo = "Via Palestrina, Monza — zona parco"
punti_forza = [
    "a 200 metri dall'entrata del Parco di Monza e 500 dalla Villa Reale",
    "10 minuti a piedi dall'ospedale San Gerardo",
    "stanze ampie e luminose, a uso singolo",
    "appartamento grande e arredato, 180 mq con 5 stanze e due bagni condivisi",
    "secondo piano di uno stabile signorile e tranquillo, con giardino e portineria",
    "ampia cucina full optional, grande soggiorno luminoso, balcone e due ripostigli",
    "fermata del bus a 4 minuti a piedi, linee per la stazione e per Sesto San Giovanni",
    "bar, farmacia e un Iper molto fornito a 5 minuti a piedi",
    "parcheggio libero su strada e garage per bici e moto",
]
# Citate solo se il post le rende rilevanti (chi ha un cane, chi fuma).
regole = "In casa non si fuma e non sono ammessi animali."
# Cose che qualcuno chiede e noi non abbiamo: il composer deve dirle subito,
# non lasciarle scoprire alla visita.
non_abbiamo = "il bagno in camera: i due bagni sono condivisi fra tutti"

[matching]
# Il criterio non è la distanza, è il prezzo di mercato: Monza costa più dei
# comuni intorno, e chi cerca dove si paga meno (Lesmo, Seregno, Desio,
# Limbiate...) ha in testa cifre più basse delle nostre. Proporgli una stanza a
# Monza è competere con un mercato diverso, anche se sulla mappa è a 10 km.
zone_accettate = [
    "Monza", "Villasanta", "Brugherio", "Vedano al Lambro", "Lissone",
    "Muggiò", "Concorezzo", "Biassono", "Sesto San Giovanni", "Cinisello Balsamo",
]
escludi_tipologie = ["monolocale", "bilocale", "appartamento"]

[telegram]
bot_token = "METTI-QUI-IL-TOKEN"
chat_id = "METTI-QUI-IL-CHAT-ID"   # lo ricavi da https://api.telegram.org/bot<TOKEN>/getUpdates dopo aver scritto al bot
